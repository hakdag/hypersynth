# Copy to `.env` in repo root for docker-compose (optional overrides).
POSTGRES_USER=hypersynth
POSTGRES_PASSWORD=hypersynth
POSTGRES_DB=hypersynth
POSTGRES_PORT=5432

# Backend (set when running hypersynth-api, not consumed by compose).
PORT=3000
CORS_ORIGIN=http://localhost:4200
DATABASE_URL=postgres://hypersynth:hypersynth@localhost:5432/hypersynth
# Session cookie lifetime in seconds (default 604800 = 7 days).
SESSION_MAX_AGE_SECS=604800
# Folder where project document uploads are stored by the backend.
DOCUMENT_UPLOAD_DIR=./uploaded-documents
# Master secret used to encrypt project AI API keys at rest (AES-256-GCM).
# Must be base64-encoded 32 random bytes. Generate with:
#   openssl rand -base64 32
# Never commit the real value; the backend refuses to start if this is missing
# or invalid, which also prevents AI key storage and runtime AI execution.
API_KEY_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes

# Anthropic runtime settings for AI requirement enhancement.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TIMEOUT_SECS=30

# Team invitations (SF-15): public URL of the Angular app (no trailing slash). Used in invitation email links.
APP_BASE_URL=http://localhost:4200
# Hours until a pending invitation expires (default 168 = 7 days).
INVITATION_EXPIRES_IN_HOURS=168

# SMTP (required for sending invitation emails). Use Mailpit/MailHog locally on 1025/587 as needed.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=ignored
SMTP_PASSWORD=ignored
SMTP_FROM_EMAIL=noreply@example.test
SMTP_FROM_NAME=HyperSynth
# `false` = plain SMTP (MailHog on 1025). `true` = STARTTLS (e.g. port 587).
SMTP_STARTTLS=false
