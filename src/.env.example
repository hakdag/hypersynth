# Copy to `.env` in repo root for docker-compose (optional overrides).
POSTGRES_USER=hypersynth
POSTGRES_PASSWORD=hypersynth
POSTGRES_DB=hypersynth
POSTGRES_PORT=5432

# Backend (set when running hypersynth-api, not consumed by compose).
PORT=3000
CORS_ORIGIN=http://localhost:4200
DATABASE_URL=postgres://hypersynth:hypersynth@localhost:5432/hypersynth
# Session cookie lifetime in seconds (default 604800 = 7 days).
SESSION_MAX_AGE_SECS=604800
# Folder where project document uploads are stored by the backend.
DOCUMENT_UPLOAD_DIR=./uploaded-documents
